{
  "name": "flaredrive-r2",
  "version": "0.0.2",
  "description": "😁基于cloudflare-r2实现的网盘，可以实现文件分享功能",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev . --r2 BUCKET --port 8788 --compatibility-date=2026-11-15",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist --r2 BUCKET --port 8788 --compatibility-date=2026-11-15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willow-god/FlareDrive-R2.git"
  },
  "author": "longern",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/willow-god/FlareDrive-R2/issues"
  },
  "homepage": "https://github.com/willow-god/FlareDrive-R2#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "vue": "^3.5.45"
  }
}
